{% comment %}
  Renders product images

  Usage:
  {% render 'custom-product-media' %}
{% endcomment %}

{% assign gallery_viewer_default = 'products.product.media.gallery_viewer_default' | t %}
<div
  class="product_image w-full flex flex-nowrap flex-col xl:flex-row-reverse lg:flex-col"
  aria-label="{{ 'products.product.media.gallery_viewer' | t: default: gallery_viewer_default | escape }}"
>
  <div
    class="swiper mainSwiper w-full md:max-w-200 md:max-h-170 lg:max-w-250 lg:max-h-215 mb-4 sm:mb-4 lg:mb-4 xl:mb-0"
    role="region"
    aria-roledescription="{{ 'products.product.media.carousel'}}"
    aria-label="{{ 'products.product.media.main_images_aria_label' | t | escape }}"
  >
    <div class="swiper-wrapper ">
      {%- for media in product.media -%}
        <div
          class="image-container swiper-slide flex relative"
          role="group"
          aria-label="Image {{ forloop.index }} of {{ product.media.size }}"
          data-media-id="{{ media.id }}"
          data-media-color="{{ media.alt | downcase }}"
        >
          {%- if media != blank -%}
            {%- assign product_price = product.selected_or_first_available_variant -%}
            {%- if product_price.price < product_price.compare_at_price -%}
              <div class="absolute inline-flex items-center top-6 left-6 bg-white text-black text-2xl px-3 py-3 rounded-lg">
                {{ 'star-icon.svg' | inline_asset_content }}
                <span>
                  {{ 'products.product.on_sale' | t | escape }}
                </span>
              </div>
            {%- endif -%}

            {%- assign alt_text = media.preview_image.alt
              | append: ' '
              | append: product.title
              | append: ' '
              | append: forloop.index
              | append: ' of '
              | append: product.media.size
              | escape
            -%}
            {%- assign alt_text = media.preview_image.alt | default: product.title -%}
            {{-
              media
              | image_url: width: 536, height: 536
              | image_tag:
                loading: 'eager',
                width: 443,
                height: 443,
                alt: alt_text,
                fetchpriority: 'high',
                class: 'w-full h-full object-cover rounded-xl'
            -}}
          {%- else -%}
            {{- 'product-2' | placeholder_svg_tag: 'placeholder-img' -}}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="swiper-button-next hidden"></div>
    <div class="swiper-button-prev hidden"></div>
  </div>
  <div
    class="swiper thumbSwiper w-full md:max-w-200 md:max-h-40 md:max-200 xl:max-w-40 lg:max-h-215 py-2  mx-auto"
    role="group"
    aria-label="{{ 'products.product.media.thumbnail_images_aria_label' | t| escape }}"
  >
    <div class="swiper-wrapper pt-4 pb-4 md:pt-1.5 md:pb-2 md:pl-2">
      {%- for media in product.media -%}
        <div
          class="swiper-slide cursor-pointer rounded-xl focus-visible"
          data-media-id="{{ media.id }}"
          aria-label="Show image {{ forloop.index }} of {{ product.media.size }}"
          role="button"
          tabindex="0"
          data-media-color="{{ media.alt | downcase }}"
        >
          {%- if media != blank -%}
            {%- assign alt_text = media.preview_image.alt
              | append: ' '
              | append: product.title
              | append: ' '
              | append: forloop.index
              | append: ' of '
              | append: product.media.size
              | escape
            -%}

            {%- assign alt_text = media.preview_image.alt | default: product.title -%}
            {{-
              media
              | image_url: width: 88, height: 88
              | image_tag:
                loading: 'lazy',
                width: 88,
                height: 88,
                alt: alt_text,
                fetchpriority: 'high',
                class: 'w-full h-full object-cover rounded-xl'
            -}}
          {%- else -%}
            {{- 'product-2' | placeholder_svg_tag: 'placeholder-img' -}}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
