{% comment %}
  Renders product images

  Usage:
  {% render 'custom-product-media' %}
{% endcomment %}

<div
  class="product_image w-full flex flex-nowrap flex-col xl:flex-row-reverse lg:flex-col"
  aria-label="{{ 'products.product.media.gallery_viewer' | t: default: 'Product image gallery' }}"
>
  <div
    class="swiper mySwiper2 w-full aspect-square md:max-w-200 md:max-h-170 lg:max-w-250 lg:max-h-215 mb-4 md:mb-6"
    role="region"
    aria-roledescription="carousel"
    aria-label="Product images"
  >
    <div class="swiper-wrapper">
      {%- for media in product.media -%}
        <div
          class="image-container swiper-slide flex cursor-pointer relative"
          role="group"
          aria-label="Image {{ forloop.index }} of {{ product.media.size }}"
          data-media-id="{{ media.id }}"
        >
          {%- if media != blank -%}
            {%- assign product_price = product.selected_or_first_available_variant -%}
            {%- if product_price.price < product_price.compare_at_price -%}
              <div class=" absolute inline-flex items-center top-6 left-6 bg-white text-black text-2xl px-3 py-3 rounded-lg">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M9.99999 13.0721L7.11569 14.6666L7.66666 11.2895L5.33333 8.89805L8.55784 8.40571L9.99999 5.33325L11.4421 8.40571L14.6667 8.89805L12.3333 11.2895L12.8843 14.6666L9.99999 13.0721Z" fill="#111111" stroke="#111111" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>
                  {{ 'products.product.on_sale' | t }}
                </span>
              </div>
            {%- endif -%}
            <img
              src="{{ media | image_url: width: 536, height: 536 }}"
              loading="lazy"
              width="536"
              height="536"
              height="{{ 536 | divided_by: media.preview_image.aspect_ratio }}"
              alt="{{ media.preview_image.alt  | default: product.title |  escape }}"
              class="w-full h-full object-cover rounded-xl"
            >
          {%- else -%}
            {{ 'product-2' | placeholder_svg_tag: 'placeholder-img' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="swiper-button-next hidden"></div>
    <div class="swiper-button-prev hidden"></div>
  </div>

  <div
    thumbsSlider=""
    class="swiper mySwiper w-full md:max-w-200 md:max-h-40 md:max-200 xl:max-w-40 lg:max-h-215 py-2 mx-auto"
    role="group"
    aria-label="Product thumbnail previews"
  >
    <div class="swiper-wrapper">
      {%- for media in product.media -%}
        <div
          class="swiper-slide cursor-pointer rounded-xl"
          data-media-id="{{ media.id }} "
          aria-label="Show image {{ forloop.index }} of {{ product.media.size }}"
          role="button"
          tabindex="0"
        >
          {%- if media != blank -%}
            <img
              src="{{ media | image_url: width: 88, height: 88 }}"
              loading="lazy"
              loading="lazy"
              height="88"
              width="88"
              height="{{ 80 | divided_by: media.preview_image.aspect_ratio }}"
              alt="{{ media.preview_image.alt  | default: product.title |  escape }}"
              class="w-full h-full object-cover rounded-xl"
            >
          {%- else -%}
            {{ 'product-2' | placeholder_svg_tag: 'placeholder-img' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
