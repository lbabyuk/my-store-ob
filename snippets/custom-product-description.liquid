{% comment %}
  Renders product description

  Usage:
  {% render 'custom-product-description' %}
{% endcomment %}

{% assign fallback_description_text = 'products.product.fallback_description' | t %}

<div
  class="product_description text-xs leading-relaxed"
  aria-label="{{fallback_description_text  }}"
>
  {%- if product.description != blank -%}
    {{ product.description | truncate: 150, '...' }}
  {%- else -%}
    {{ fallback_description_text | truncate: 150, '...' }}
  {%- endif -%}
</div>
