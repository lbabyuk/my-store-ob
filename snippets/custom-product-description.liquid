{% comment %}
  Renders product description

  Usage:
  {% render 'custom-product-description' %}
{% endcomment %}

{%- assign fallback_description_text = 'Let your attitude have the edge in your Shoes, a Tuned Air experience that offers premium stability and unbelievable cushioning.' -%}

<div class="product_description text-neutral-500 dark:text-gray-50">
  {%- if product.description != blank -%}
    {{ product.description | default: fallback_description_text }}
  {%- else -%}
    {{ 'products.product.description' | t }}
  {%- endif -%}
</div>
