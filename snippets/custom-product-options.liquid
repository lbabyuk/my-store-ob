{% comment %}
  Renders product options

  Usage:
  {% render 'custom-product-options' %}
{% endcomment %}

{%- assign color_index = -1 -%}
{%- assign size_index = -1 -%}

{%- for option in product.options -%}
  {%- assign option_normalized = option | downcase | strip -%}
  {%- if option_normalized contains 'color'
    or option_normalized contains 'colour'
    or option_normalized contains 'колір'
  -%}
    {%- assign color_index = forloop.index0 -%}
  {%- elsif option_normalized contains 'size'
    or option_normalized contains 'shoe size'
    or option_normalized contains 'розмір'
  -%}
    {%- assign size_index = forloop.index0 -%}
  {%- endif -%}
{%- endfor -%}

{%- if color_index >= 0 -%}
  {%- assign color_index_plus = color_index | plus: 1 -%}
  {%- assign color_key = 'option' | append: color_index_plus -%}
  {%- assign colors = product.variants | map: color_key | uniq -%}

  <div class="product_option">
    <label for="color-select" class="hidden sr-only">Choose color</label>
    <select id="color-select" name="color" class="hidden sr-only">
      {%- for color in colors -%}
        <option value="{{ color | escape }}">{{ color }}</option>
      {%- endfor -%}
    </select>
    <div class="flex flex-wrap gap-4">
      {%- for color in colors -%}
        {%- assign variant = product.variants | where: color_key, color | first -%}
        {%- if variant and variant.featured_image -%}
          {%- assign image_url = variant.featured_image | image_url: width: 88 -%}
        {%- else -%}
          {%- assign image_url = product.featured_image | image_url: width: 88 -%}
        {%- endif -%}

        <label class="cursor-pointer color-label">
          <input
            type="radio"
            name="color"
            value="{{ color | escape }}"
            class="sr-only-focusable peer color-input"
            aria-label="color-input-{{ color}}"
            id="color-input-{{ color }}"
          >
          <span id="color-label-{{ forloop.index }}" class="sr-only">
            {{ color }}
          </span>

          {% if image_url != blank %}
            <span
              tabindex="0"
              class="block w-34 h-34 rounded-xl ring-1 ring-gray-200 peer-checked:ring-2 peer-checked:ring-black bg-center bg-cover dark:peer-checked:ring-2 dark:ring-red dark:peer-checked:ring-red-600 focus-visible"
              style="background-image:url({{ image_url }});"
              title="{{ color }}"
              role="presentation"
            ></span>
          {% else %}
            <span
              tabindex="0"
              class="block w-12 h-12 rounded-full ring-1 ring-gray-200 peer-checked:ring-2 peer-checked:ring-black dark:ring-gray-700 dark:peer-checked:ring-white focus-visible"
              style="background-color:{{ color | downcase }};"
              title="{{ color }}"
            ></span>
          {% endif %}
        </label>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{%- if size_index >= 0 -%}
  {%- assign size_index_plus = size_index | plus: 1 -%}
  {%- assign size_key = 'option' | append: size_index_plus -%}
  {%- assign sizes = product.variants | map: size_key | uniq -%}
  <div class="product_option">
    <div class="product_option w-full">
      <span class="block mb-2 font-medium text-xs"> {{ product.options[size_index] | default: 'Size select' }}:</span>
      <div id="size-select" class="size-chips grid! grid-cols-2 md:grid-cols-3 gap-3">
        {%- for size in sizes -%}
          {%- assign safe_size = size | remove: '(' | remove: ')' | replace: ' ', '-' -%}
          <label class="chip cursor-pointer size-label focus-visible">
            <input
              type="radio"
              name="size"
              value="{{ size | escape }}"
              class="sr-only-focusable peer size-input"
              aria-label="size-input-{{ safe_size }}"
              id="size-input-{{ safe_size }}"
            >
            <span
              tabindex="0"
              class="block text-xs text-center border border-gray-200 rounded-xl px-4 py-4 text-gray-950 peer-checked:border-black dark:text-gray-50 dark:peer-checked:border-red-600 focus-visible"
            >
              {{ size }}
            </span>
          </label>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

<div
  id="variant-data"
  aria-hidden="true"
  data-color-index="{{ color_index }}"
  data-size-index="{{ size_index }}"
>
  {%- for variant in product.variants -%}
    <span
      data-id="{{ variant.id }}"
      data-option1="{{ variant.option1 | escape }}"
      data-option2="{{ variant.option2 | escape }}"
      data-option3="{{ variant.option3 | escape }}"
      data-media-id="{{ variant.featured_media.id }}"
      data-available="{{ variant.available }}"
    ></span>
  {%- endfor -%}
</div>
