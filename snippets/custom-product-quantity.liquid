{% comment %}
  Renders product quantity

  Usage:
  {% render 'custom-product-quantity' %}
{% endcomment %}

<div class="product_quantity">
  {%- assign initial_quantity = 1 -%}
  {%- assign quantity_text = 'Quantity' -%}
  <label for="Quantity-{{ section.id }}">{{ quantity_text }}: </label>
  <div class="product_quantity__count">
    <input
      type="number"
      name="quantity"
      id="Quantity-{{ section.id }}"
      value="{{ initial_quantity }}"
      min="1"
    >
  </div>
</div>
