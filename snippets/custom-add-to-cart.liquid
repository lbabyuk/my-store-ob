{% comment %}
  Renders product add to cart button

  Usage:
  {% render 'custom-add-to-cart' %}
{% endcomment %}

{%- assign fallback_add_to_cart_text = 'products.product.fallback_add_to_cart_text' | t -%}
{%- assign fallback_sold_out_text = 'products.product.fallback_sold_out_text' | t -%}

<button
  type="button"
  class="add-to-cart-button bg-black text-white w-full pt-6 pb-6 rounded-lg cursor-pointer disabled:cursor-not-allowed transition-colors duration-300 hover:bg-neutral-500 dark:bg-white dark:text-black dark:hover:bg-neutral-700"
  name="add"
  {%- unless product.selected_or_first_available_variant.available -%}
    disabled
  {%- endunless -%}
>
  <span aria-live="polite  dark:text-gray-50">
    {%- if product.selected_or_first_available_variant.available -%}
      {{ 'products.product.add_to_cart' | t: default: fallback_add_to_cart_text | escape }}
    {%- else -%}
      {{ 'products.product.sold_out' | t: default: fallback_sold_out_text | escape }}
    {%- endif -%}
  </span>
</button>
<div
  class="form-message min-h-5 transition-opacity duration-300 pointer-events-none text-xs"
  role="status"
  aria-live="polite"
></div>
