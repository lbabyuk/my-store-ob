{% comment %}
  Renders product add to cart button

  Usage:
  {% render 'custom-add-to-cart' %}
{% endcomment %}

{%- assign fallback_add_to_cart_text = 'Add To Cart' -%}

<button
  type="button"
  class="add-to-cart-button bg-black text-white w-full pt-6 pb-6 rounded-lg cursor-pointer transition-colors duration-300 hover:bg-neutral-500"
  name="add"
  {%- unless product.selected_or_first_available_variant.available -%}
    disabled
  {%- endunless -%}
>
  <span aria-live="polite">
    {%- if product.selected_or_first_available_variant.available -%}
      {{ 'products.product.add_to_cart' | t: default: fallback_add_to_cart_text | escape }}
    {%- else -%}
      {{ 'products.product.sold_out' | t: default: fallback_add_to_cart_text | escape }}
    {%- endif -%}
  </span>
</button>

<div class="form-message" style="display:none;" role="status" aria-live="polite"></div>
