{%- style -%}
    .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  class="product section-{{ section.id }}-padding section-{{ section.id }} transition-colors duration-300"
  id="product-{{ section.id }}"
  data-section="{{ section.id }}"
  data-url="{{ product.url }}"
  data-section-id="{{ section.id }}"
>
  <div class="page-width">
    {%- assign not_available_text = 'No product available at the moment.' -%}
    {%- if product == null -%}
      <div class="title-wrapper text-center">
        <h2 class="title">
          {{ not_available_text }}
        </h2>
      </div>
    {%- else -%}
      <div class="product-wrapper grid! grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-10">
        {%- render 'custom-product-media' -%}
        <div class="product-info flex flex-col gap-8">
          <div class="product_title">
            {%- if product.title == blank -%}
              <h1 class="product_title">{{ product.title | escape }}</h1>
            {% else %}
              <h1 class="product_title">{{ product.handle | capitalize }}</h1>
            {%- endif -%}
          </div>
          {%- form 'product', product, class: 'form', data-type: 'add-to-cart-form' -%}
            <div class="product-form-wrapper flex flex-col gap-8">
              <input
                type="hidden"
                name="id"
                value="{{ product.selected_or_first_available_variant.id }}"
                class="sr-only"
                aria-hidden="true"
              >
              {%- render 'custom-product-price' -%}
              {%- render 'custom-product-options' -%}
            </div>
            <input
              type="hidden"
              name="id"
              id="selected-variant-id"
              value="{{ product.selected_or_first_available_variant.id }}"
              class="sr-only"
              aria-hidden="true"
            >
            {%- render 'custom-add-to-cart' -%}
          {%- endform -%}
          {%- render 'custom-product-description' -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'custom-script.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Custom featured product",
  "tag": "section",
  "class": "section section-featured-product",
  "disabled_on": {
    "groups": ["header", "footer"]
  },

  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.featured-product.settings.product.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },

    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Custom featured product"
    }
  ]
}
{% endschema %}
